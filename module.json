{
  "schema": "lifeplanner.module.v1",
  "id": "freizeitmanager",
  "name": "FreizeitManager",
  "version": "0.1.1",
  "description": "Freundschaftspflege, Kontaktrotation, Aktivitaeten und Freizeitplanung.",
  "source_entry": "main.py",
  "windows_executable": "FreizeitManager/FreizeitManager.exe",
  "linux_executable": "FreizeitManager/FreizeitManager",
  "permissions": [
    "own_data_read",
    "own_data_write",
    "bridge_read",
    "bridge_write"
  ],
  "environment": {
    "FREIZEITMANAGER_DATA_DIR": "{module_data_dir}",
    "LIFEPLANNER_MODULE_DATA_DIR": "{module_data_dir}",
    "LIFEPLANNER_BRIDGE_DIR": "{bridge_dir}",
    "LIFEPLANNER_CENTRAL_UPDATER": "1"
  }
}
